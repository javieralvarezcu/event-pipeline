{
  // Entorno de desarrollo: BD SQL Server de docker-compose.dev.yml (BD RECIÉN
  // creada, sin tablas legacy). MigrateOnStartup=true solo vale para esta BD
  // fresca de desarrollo — NUNCA contra la BD compartida de producción.
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1434;Database=EventPipelineDb;User Id=sa;Password=Your_password123;TrustServerCertificate=true"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  // Login de desarrollo: admin / dev-password-123 (se fuerza el cambio en el primer login).
  "Auth": {
    "AdminUsername": "admin",
    "InitialAdminPassword": "dev-password-123"
  }
}
