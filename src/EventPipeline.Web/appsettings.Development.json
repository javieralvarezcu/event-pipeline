{
  // Entorno de desarrollo: fichero SQLite en la raíz del repo (eventpipeline-dev.db,
  // ignorado por git; la ruta es relativa al directorio del proyecto). Lo crea y
  // migra la Web en el primer arranque. Lo comparte la Api.
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=../../eventpipeline-dev.db"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  // Login de desarrollo: admin / dev-password-123 (se fuerza el cambio en el primer login).
  "Auth": {
    "AdminUsername": "admin",
    "InitialAdminPassword": "dev-password-123"
  }
}
