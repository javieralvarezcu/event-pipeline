<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One-off tool: copies the data of an existing SQL Server EventPipelineDb into a
    new SQLite database. Not part of the Docker images (they only copy src/).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EventPipeline.Core\EventPipeline.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.18" />
  </ItemGroup>

</Project>
